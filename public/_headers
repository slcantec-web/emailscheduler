/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; worker-src 'self'

/api/*
  Cache-Control: no-store
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'

# Share images: minimal headers so WhatsApp / Facebook crawlers accept them
/share-card.jpg
  Content-Type: image/jpeg
  Cache-Control: public, max-age=604800, immutable
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

/og-image.png
  Content-Type: image/png
  Cache-Control: public, max-age=604800, immutable
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

/apple-touch-icon.png
  Content-Type: image/png
  Cache-Control: public, max-age=604800
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

/robots.txt
  Content-Type: text/plain; charset=utf-8

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
